# Copy this file to .env and replace each placeholder. Never commit .env.
TELEGRAM_BOT_TOKEN=your-bot-token
TELEGRAM_CHAT_ID=@your_free_channel
TELEGRAM_VIP_CHAT_ID=-1001234567890
# Optional: GitHub PAT (classic, with `repo` scope) used by run_local.bat for
# authenticated `git push origin main`, so you don't need the Windows Git
# Credential Manager. Leave blank to fall back to system git credentials.
GITHUB_PAT=your_github_personal_access_token
